@model PropertyRental.Web.ViewModels.Properties.PropertyListViewModel

@if (Model.Properties.Count == 0)
{
    <div class="alert alert-light border mb-0" role="status">No properties have been added yet.</div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Address</th>
                    <th scope="col">Description</th>
                    <th scope="col">Units</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var property in Model.Properties)
            {
                <tr>
                    <td class="fw-semibold">@property.Name</td>
                    <td>@property.Address</td>
                    <td class="text-body-secondary">@property.Description</td>
                    <td>@property.UnitCount</td>
                    <td class="text-end text-nowrap">
                        <button type="button" class="btn btn-sm btn-outline-primary" data-modal-url="@Url.Action("Edit", new { id = property.Id })">
                            Edit
                        </button>
                        <form asp-action="Delete" asp-route-id="@property.Id" method="post" class="d-inline" data-delete-property data-property-name="@property.Name">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
