@model PropertyRental.Web.ViewModels.Properties.PropertyListViewModel

@{
    ViewData["Title"] = "Properties";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Properties</h1>
        <p class="text-body-secondary mb-0">Manage the buildings and communities in your portfolio.</p>
    </div>
    <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("Create")">
        Add property
    </button>
</div>

<div id="property-list">
    <partial name="_PropertyTable" model="Model" />
</div>

@section Scripts {
    <script src="~/js/properties.js" asp-append-version="true"></script>
}
