@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="h2">We could not complete your request</h1>
<p role="alert">Please try again. If the issue continues, provide the request ID below when contacting support.</p>
<a class="btn btn-outline-primary mb-3" asp-controller="Home" asp-action="Index">Return home</a>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}
