@model PropertyRental.Web.ViewModels.Applications.ResidenceFormViewModel
<div class="modal-header">
    <h2 class="modal-title fs-5">Delete residence</h2>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<form asp-action="DeleteResidence" asp-route-applicationId="@Model.ApplicationId" asp-route-residenceId="@Model.ResidenceId" method="post" data-modal-form>
    <div class="modal-body">
        <div class="alert alert-danger d-none" data-modal-error role="alert"></div>
        <p>Delete the residence at <strong>@Model.Address</strong>?</p>
        <p class="mb-0">This cannot be undone.</p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
    </div>
</form>
