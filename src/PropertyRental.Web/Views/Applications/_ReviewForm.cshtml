@model PropertyRental.Web.ViewModels.Reviews.ApplicationReviewViewModel
<div class="modal-header">
    <h2 class="modal-title fs-5">Review application #@Model.ApplicationId</h2>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<form method="post" action="@Url.Action("Create", "Reviews", new { id = Model.ApplicationId })" data-modal-form>
    @Html.AntiForgeryToken()
    <div class="modal-body">
        <div class="alert alert-danger d-none" data-modal-error role="alert"></div>
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Outcome" class="form-label"></label>
            <select asp-for="Outcome" class="form-select"><option value="">Choose a decision</option><option value="Approved">Approve</option><option value="Returned">Return for corrections</option><option value="Denied">Deny</option></select>
            <span asp-validation-for="Outcome" class="text-danger"></span>
        </div>
        <div class="mb-3"><label asp-for="Comment" class="form-label"></label><textarea asp-for="Comment" class="form-control" rows="4" aria-describedby="review-comment-help"></textarea><span asp-validation-for="Comment" class="text-danger"></span></div>
        <p id="review-comment-help" class="form-text">A comment is required for Return and Deny. Return comments are visible to the applicant.</p>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save decision</button></div>
</form>
