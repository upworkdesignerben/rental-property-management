@model PropertyRental.Web.ViewModels.Applications.ResidenceFormViewModel
<div class="modal-header">
    <h2 class="modal-title fs-5">@(Model.ResidenceId.HasValue ? "Edit residence" : "Add residence")</h2>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<form method="post" action="@Url.Action(Model.ResidenceId.HasValue ? "EditResidence" : "AddResidence", new { applicationId = Model.ApplicationId, residenceId = Model.ResidenceId })" data-modal-form>
    @Html.AntiForgeryToken()
    <div class="modal-body">
        <div class="alert alert-danger d-none" data-modal-error role="alert"></div>
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="mb-3"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /><span asp-validation-for="Address" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="LandlordName" class="form-label"></label><input asp-for="LandlordName" class="form-control" /><span asp-validation-for="LandlordName" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="LandlordPhone" class="form-label"></label><input asp-for="LandlordPhone" class="form-control" /><span asp-validation-for="LandlordPhone" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="MoveInDate" class="form-label"></label><input asp-for="MoveInDate" class="form-control" /><span asp-validation-for="MoveInDate" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="MoveOutDate" class="form-label"></label><input asp-for="MoveOutDate" class="form-control" /><span asp-validation-for="MoveOutDate" class="text-danger"></span></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save residence</button></div>
</form>
