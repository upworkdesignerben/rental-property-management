@model PropertyRental.Web.ViewModels.Applications.ResidenceHistoryViewModel
<div class="d-flex justify-content-between align-items-center gap-2 mb-3">
    <h2 class="h5 mb-0">Residence history</h2>
    <button type="button" class="btn btn-outline-primary" data-modal-url="@Url.Action("AddResidence", new { applicationId = Model.ApplicationId })">Add residence</button>
</div>
<p class="text-body-secondary">Add previous residences if applicable, then save and continue.</p>
<div class="alert alert-danger d-none" data-residence-error role="alert"></div>
<div id="residence-list" data-refresh-url="@Url.Action("ResidenceList", new { applicationId = Model.ApplicationId })">
    <partial name="_ResidenceList" model="Model" />
</div>
