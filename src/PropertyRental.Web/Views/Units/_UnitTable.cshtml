@model PropertyRental.Web.ViewModels.Units.UnitListViewModel

@if (Model.Units.Count == 0)
{
    <div class="alert alert-light border mb-0" role="status">No units match this filter.</div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Property</th>
                    <th scope="col">Unit</th>
                    <th scope="col">Type</th>
                    <th scope="col">Bedrooms</th>
                    <th scope="col">Monthly rent</th>
                    <th scope="col">Availability</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var unit in Model.Units)
            {
                <tr>
                    <td class="fw-semibold">@unit.PropertyName</td>
                    <td>@unit.UnitNumber</td>
                    <td>@unit.UnitTypeName</td>
                    <td>@unit.Bedrooms</td>
                    <td>@unit.MonthlyRent.ToString("C")</td>
                    <td>
                        @if (unit.IsAvailable)
                        {
                            <span class="badge text-bg-success">Available</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Leased</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <button type="button" class="btn btn-sm btn-outline-primary" data-modal-url="@Url.Action("Edit", new { id = unit.Id })">Edit</button>
                        <form asp-action="Delete" asp-route-id="@unit.Id" method="post" class="d-inline" data-delete-unit data-unit-number="@unit.UnitNumber">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
