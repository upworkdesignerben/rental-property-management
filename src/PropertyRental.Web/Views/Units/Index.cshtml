@model PropertyRental.Web.ViewModels.Units.UnitListViewModel

@{
    ViewData["Title"] = "Units";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Units</h1>
        <p class="text-body-secondary mb-0">Manage individual rental units and their availability.</p>
    </div>
    <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("Create")">Add unit</button>
</div>

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-sm-6 col-md-4">
        <label for="propertyId" class="form-label">Property</label>
        <select id="propertyId" name="propertyId" class="form-select" onchange="this.form.submit()">
            <option value="">All properties</option>
            @foreach (var property in Model.Properties)
            {
                <option value="@property.Id" selected="@(property.Id == Model.PropertyId)">@property.Name</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
    </div>
</form>

<partial name="_UnitTable" model="Model" />

@section Scripts {
    <script src="~/js/units.js" asp-append-version="true"></script>
}
