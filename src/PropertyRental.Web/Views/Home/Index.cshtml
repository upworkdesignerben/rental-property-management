@{
    ViewData["Title"] = "Home";
}

<section class="p-4 p-md-5 bg-light rounded-3 border my-4">
    <h1 class="display-5 fw-bold">Your next home starts here</h1>
    <p class="lead">Browse available rentals, complete your application, and follow its progress in one place.</p>
    <div class="d-flex flex-wrap gap-2 mt-4">
        @if (User.IsInRole("PropertyManager"))
        {
            <a class="btn btn-primary" asp-controller="Applications" asp-action="Index">Review applications</a>
            <a class="btn btn-outline-primary" asp-controller="Properties" asp-action="Index">Manage properties</a>
        }
        else if (User.IsInRole("Applicant"))
        {
            <a class="btn btn-primary" asp-controller="Units" asp-action="Available">Find a rental</a>
            <a class="btn btn-outline-primary" asp-controller="Applications" asp-action="Index">My applications</a>
        }
        else
        {
            <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Register">Create an account</a>
            <a class="btn btn-outline-primary" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
        }
    </div>
</section>
